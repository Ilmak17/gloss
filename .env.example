# Server-side only. Visitors can also paste their own key in the app.
TOGETHER_API_KEY=

# Postgres on Neon. Create the tables with `npm run db:migrate`.
DATABASE_URL=

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional; only readers with their own Together key can use it.
LLAMA_CLOUD_API_KEY=

# Optional local narration. Voice settings can override these in this browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Kokoro via DeepInfra (default narration provider; server-side only).
DEEPINFRA_API_KEY=
# Optional absolute path for persistent local audio; default: .data/audio.
# GLOSS_AUDIO_CACHE_DIR=
# GLOSS_AUDIO_CACHE=off

# Optional: private GitHub repository for local library backups.
# Clone to .data/github-backup on main and authenticate gh first.
# GLOSS_BACKUP_REPOSITORY=your-name/gloss-backup
